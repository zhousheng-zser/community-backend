# HTTP 端口（与 admin 开发代理 VITE_PROXY_TARGET 默认 3001 对齐；未设置时代码里默认 3000）
# PORT=3001

# 数据库等（按需）
# DB_HOST=
# DB_USER=
# DB_PASSWORD=

# 本地集市微信支付 API v3（真实支付）
# WX_PAY_APPID=小程序 AppID（或与 WECHAT_APPID 二选一）
# WECHAT_APPID=
# WX_PAY_MCHID=商户号
# WX_PAY_SERIAL_NO=商户 API 证书序列号
# WX_PAY_API_V3_KEY=32 位 APIv3 密钥
# 私钥二选一：文件路径（推荐）或 PEM 字符串（\n 写成 \\n）
# WX_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
# WX_PAY_PRIVATE_KEY=
# 须与商户平台「支付回调」配置一致，HTTPS 公网可访问
# WX_PAY_NOTIFY_URL=https://your-domain.com/api/v1/market/pay/callback
# 回调验签（商户平台已切公钥模式时必填，勿使用占位文案）
# WX_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WX_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 未配置 WX_PAY_* 时：默认走「虚拟支付」直通货已支付（仅联调）。上线真支付请设为 false
# MARKET_PAY_VIRTUAL_SUCCESS=false

# 联调脚本拼接完整图片 URL（接口仍返回相对路径 /uploads/...）
# PUBLIC_API_BASE=https://your-domain.com:3000

# 店铺详情接口打印图片字段调试日志（需重启）
# LOG_MARKET_IMAGE_DEBUG=1

# 本地集市店铺列表默认半径（公里），与纪要 07 的 5km 一致
# MARKET_SHOP_RADIUS_KM=5

# ---------- 聚合配送（美团 / 蜂鸟）----------
# 无平台凭证时建议 DELIVERY_MOCK=1；拿到测试 AppKey 后改 0
# DELIVERY_MOCK=1
# PUBLIC_API_BASE=https://your-domain.com/api/v1
# DELIVERY_WEBHOOK_BASE=https://your-domain.com/api/v1

# 美团配送开放平台（平台级一套，每店 shop_id 见 merchant_shop_delivery_bindings）
# MEITUAN_APP_KEY=
# MEITUAN_SECRET=
# MEITUAN_SERVICE_CODE=4012
# MEITUAN_SHOP_CATEGORY=110
# MEITUAN_SHOP_SECOND_CATEGORY=110001
# 兼容旧单店配置（多店请用绑定表，勿依赖此项）
# MEITUAN_SHOP_ID=

# 饿了么蜂鸟即配
# ELEME_APP_KEY=
# ELEME_SECRET=
# ELEME_CHAIN_STORE_CODE=

# 一期联调自定义回调验签（无 Wechatpay-Signature 头时使用）
# PAY_CALLBACK_SECRET=

# ---------- 管理后台登录（/api/v1/auth/admin/login）----------
# ADMIN_USERNAME=wsxCDE
# ADMIN_PASSWORD=请设置强密码
# 非 production（或未设 NODE_ENV）时默认不校验密码；生产环境（NODE_ENV=production）必须校验
# 本地若也要校验密码：ADMIN_FORCE_PASSWORD=1
# 仍兼容显式跳过：DEBUG_ADMIN_LOGIN=1（生产慎用）

# ---------- 调试专用：跳过登录密码（切勿用于生产）----------
# DEBUG_ADMIN_LOGIN=1
# DEBUG_MERCHANT_LOGIN=1
